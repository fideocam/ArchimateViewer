    </element>
    <element identifier="id-register" xsi:type="BusinessProcess">
      <name xml:lang="en">Register Claim</name>
    </element>
    <element identifier="id-claim" xsi:type="BusinessObject">
      <name xml:lang="en">Claim</name>
    </element>
