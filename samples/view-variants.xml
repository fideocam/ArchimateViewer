<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       identifier="id-model-variants">
  <name>View variants</name>
  <elements>
    <element identifier="id-actor" xsi:type="BusinessActor"><name>Claims Actor</name></element>
    <element identifier="id-role" xsi:type="BusinessRole"><name>Clerk Role</name></element>
    <element identifier="id-group" xsi:type="Grouping"><name>Claims Group</name></element>
    <element identifier="id-proc" xsi:type="BusinessProcess"><name>Handle Claim</name></element>
    <element identifier="id-obj" xsi:type="BusinessObject"><name>Claim File</name></element>
  </elements>
  <relationships>
    <relationship identifier="id-r-comp" source="id-group" target="id-actor" xsi:type="Composition"/>
    <relationship identifier="id-r-agg" source="id-group" target="id-role" xsi:type="Aggregation"/>
    <relationship identifier="id-r-asg" source="id-actor" target="id-proc" xsi:type="Assignment"/>
    <relationship identifier="id-r-acc" source="id-proc" target="id-obj" xsi:type="Access" accessType="Write"/>
  </relationships>
  <views>
    <viewpoints>
      <viewpoint identifier="id-vp-org">
        <name>Organization catalog</name>
      </viewpoint>
    </viewpoints>
    <diagrams>
      <view identifier="id-folder">
        <name>Folder</name>
        <view identifier="id-view-nested" xsi:type="Diagram">
          <name>Nested diagram</name>
          <node identifier="n-nested-actor" xsi:type="Element" elementRef="id-actor" x="40" y="40" w="140" h="60"/>
        </view>
      </view>
      <view identifier="id-view-viewpoint" xsi:type="Diagram" viewpoint="Organization">
        <name>Organization viewpoint</name>
        <viewRef ref="id-view-archi"/>
      </view>
      <view identifier="id-view-ref" xsi:type="Diagram">
        <name>Referenced overview</name>
        <node identifier="n-ref" xsi:type="Label" w="0" h="0">
          <label>Drill into nested</label>
          <viewRef ref="id-view-nested"/>
        </node>
      </view>
      <view identifier="id-view-nobounds" xsi:type="Diagram">
        <name>No bounds</name>
        <node identifier="n-actor" xsi:type="Element" elementRef="id-actor" width="140" height="60"/>
        <node identifier="n-proc" xsi:type="Element" elementRef="id-proc">
          <bounds x="200" y="40" width="160" height="55"/>
        </node>
        <connection identifier="c-asg" xsi:type="Relationship" relationshipRef="id-r-asg" source="id-actor" target="id-proc"/>
      </view>
      <view identifier="id-view-group" xsi:type="Diagram">
        <name>Empty grouping</name>
        <node identifier="n-group" xsi:type="Element" elementRef="id-group" x="20" y="20" w="360" h="160"/>
      </view>
      <view identifier="id-view-archi" xsi:type="Diagram">
        <name>Archi child bounds</name>
        <child identifier="n-archi-actor" xsi:type="Element" elementRef="id-actor">
          <bounds x="40" y="40" width="140" height="60"/>
        </child>
        <child identifier="n-archi-obj" xsi:type="Element" elementRef="id-obj">
          <bounds x="240" y="40" width="140" height="60"/>
        </child>
        <connection identifier="c-acc" relationshipRef="id-r-acc" source="n-archi-actor" target="n-archi-obj"/>
      </view>
      <view identifier="id-view-conns" xsi:type="Diagram">
        <name>Connections only</name>
        <connection identifier="c-only" xsi:type="Relationship" relationshipRef="id-r-asg" source="id-actor" target="id-proc"/>
      </view>
    </diagrams>
  </views>
</model>
