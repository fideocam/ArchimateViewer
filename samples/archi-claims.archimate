<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Archi Claims" id="id-model" version="5.0.0">
  <folder name="Business" id="id-f-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Customer" id="id-customer">
      <documentation>Person filing a claim</documentation>
    </element>
    <folder name="Processes" id="id-f-processes">
      <element xsi:type="archimate:BusinessProcess" name="Handle Claim" id="id-handle"/>
      <element xsi:type="archimate:BusinessObject" name="Claim" id="id-claim"/>
    </folder>
  </folder>
  <folder name="Application" id="id-f-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Claims App" id="id-app"/>
  </folder>
  <folder name="Motivation" id="id-f-motivation" type="motivation">
    <element xsi:type="archimate:Goal" name="Fast payout" id="id-goal"/>
  </folder>
  <folder name="Other" id="id-f-other" type="other">
    <element xsi:type="archimate:Junction" id="id-junction" type="or"/>
  </folder>
  <folder name="Relations" id="id-f-relations" type="relations">
    <element xsi:type="archimate:AssignmentRelationship" id="id-r-assign" source="id-customer" target="id-handle"/>
    <element xsi:type="archimate:AccessRelationship" id="id-r-read" source="id-handle" target="id-claim" accessType="1"/>
    <element xsi:type="archimate:AccessRelationship" id="id-r-write" source="id-app" target="id-claim"/>
    <element xsi:type="archimate:ServingRelationship" name="serves" id="id-r-serve" source="id-app" target="id-handle"/>
    <element xsi:type="archimate:InfluenceRelationship" id="id-r-inf" source="id-handle" target="id-goal" strength="++"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-r-assoc" source="id-customer" target="id-goal" directed="true"/>
  </folder>
  <folder name="Views" id="id-f-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="Main View" id="id-view-main">
      <documentation>Main claims view</documentation>
      <child xsi:type="archimate:Group" id="id-d-group" name="Business Layer" fillColor="#e0e0e0">
        <bounds x="20" y="20" width="500" height="200"/>
        <child xsi:type="archimate:DiagramObject" id="id-d-customer" archimateElement="id-customer" fillColor="#ffffb5" font="1|Segoe UI|9.0|1|WINDOWS|1|-12|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI">
          <bounds x="20" y="40" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-c-assign" source="id-d-customer" target="id-d-handle" archimateRelationship="id-r-assign"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-d-handle" targetConnections="id-c-assign id-c-serve" archimateElement="id-handle">
          <bounds x="240" y="40" width="-1" height="-1"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-c-read" source="id-d-handle" target="id-d-claim" archimateRelationship="id-r-read">
            <bendpoint startX="0" startY="80" endX="-100" endY="0"/>
          </sourceConnection>
        </child>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-d-claim" targetConnections="id-c-read" archimateElement="id-claim">
        <bounds x="400" y="300" width="120" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-d-app" archimateElement="id-app" lineColor="#205c5c">
        <bounds x="40" y="300" width="160" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-c-serve" source="id-d-app" target="id-d-handle" archimateRelationship="id-r-serve"/>
      </child>
      <child xsi:type="archimate:Note" id="id-d-note" textAlignment="1">
        <bounds x="600" y="20" width="185" height="80"/>
        <content>Claims are handled within 5 days</content>
      </child>
      <child xsi:type="archimate:DiagramModelReference" id="id-d-ref" model="id-view-motivation">
        <bounds x="600" y="300" width="120" height="55"/>
      </child>
    </element>
    <folder name="More" id="id-f-views-more">
      <element xsi:type="archimate:ArchimateDiagramModel" name="Motivation" id="id-view-motivation">
        <child xsi:type="archimate:DiagramObject" id="id-d2-handle" archimateElement="id-handle">
          <bounds x="20" y="20" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-c2-inf" source="id-d2-handle" target="id-d2-goal" archimateRelationship="id-r-inf"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-d2-goal" targetConnections="id-c2-inf" archimateElement="id-goal">
          <bounds x="300" y="20" width="120" height="55"/>
        </child>
      </element>
    </folder>
    <element xsi:type="archimate:SketchModel" name="Sketch" id="id-sketch">
      <child xsi:type="archimate:SketchModelSticky" id="id-sticky" name="Idea">
        <bounds x="10" y="10" width="75" height="63"/>
      </child>
    </element>
  </folder>
</archimate:model>
